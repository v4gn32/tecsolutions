// prisma/schema.prisma
// ---------- PRISMA CONFIG ----------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Role {
  ADMIN
  TECH
}

enum ClientType {
  CONTRACT // Contrato
  ONE_OFF // Avulso
}

enum ProposalStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

enum ServiceType {
  REMOTE
  ONSITE
  LAB
  THIRD_PARTY
}

enum ItemType {
  PRODUCT
  SERVICE
}

// ---------- MODELS ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TECH)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos futuros
  proposalsCreated Proposal[]   @relation("ProposalCreatedBy")
  attendances      Attendance[] @relation("AttendanceTechnician")
}

model Client {
  id        String     @id @default(cuid())
  name      String
  type      ClientType @default(ONE_OFF) // Contrato / Avulso
  email     String?
  phone     String?
  document  String? // CPF/CNPJ (opcional)
  address   String?
  notes     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  proposals   Proposal[]
  attendances Attendance[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  unit        String? // ex: "hora", "unidade"
  unitPrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposalItems ProposalItem[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String?
  unit        String? // ex: "unidade", "caixa"
  unitPrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposalItems ProposalItem[]
}

model Proposal {
  id          String         @id @default(cuid())
  number      String         @unique // ex: TS-2025-0001
  clientId    String
  createdById String
  status      ProposalStatus @default(DRAFT)
  validUntil  DateTime?
  notes       String?

  // Totais (snapshot)
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client         @relation(fields: [clientId], references: [id])
  createdBy User           @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  items     ProposalItem[]
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  itemType   ItemType
  productId  String?
  serviceId  String?

  // Snapshot para manter histórico mesmo que preço mude
  name        String
  description String?
  quantity    Decimal @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  proposal Proposal @relation(fields: [proposalId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])
}

model Attendance {
  id           String      @id @default(cuid())
  type         ServiceType
  date         DateTime    @default(now())
  clientId     String
  technicianId String
  hours        Decimal     @default(0) @db.Decimal(10, 2)
  materials    Json?
  description  String?
  status       String? // ex: "ABERTO", "CONCLUÍDO"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client     Client @relation(fields: [clientId], references: [id])
  technician User   @relation("AttendanceTechnician", fields: [technicianId], references: [id])
}
